# ---------- App ----------
APP_NAME="AI Career Helper"
APP_ENV=development            # development | production | test
DEBUG=true
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string          # signs JWTs + session cookie
TOKEN_ENCRYPTION_KEY=                                  # Fernet key; generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AUTO_CREATE_TABLES=true        # dev convenience; use Alembic in production

# ---------- Database ----------
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/career

# ---------- Auth ----------
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# ---------- Claude ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- LinkedIn (OpenID Connect sign-in) ----------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------- Google (OAuth 2.0: sign-in; Calendar/Gmail scopes requested later) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Search / Jobs (used from Phase 4 / 7) ----------
SEARCH_PROVIDER=tavily         # tavily | serpapi | brave
TAVILY_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
